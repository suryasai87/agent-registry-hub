  "external_ext_mcp_you_dot_com": {
    "path": "POST /api/2.0/mcp/external/ext_mcp_you_dot_com",
    "http": 200,
    "tool_count": 1,
    "tool_field_presence": {
      "name": 1,
      "title": 1,
      "description": 1,
      "inputSchema": 1,
      "annotations": 1,
      "outputSchema": 1
    },
    "tools": [
      {
        "name": "you-finance",
        "title": "Finance Research",
        "description": "Research financial topics \u2014 company financials, SEC filings, earnings, guidance, analyst context, valuation, markets, and macro \u2014 returning a cited answer. Use for finance-specific questions requiring financial-data sources. Configurable effort levels (deep, exhaustive).\n\nThis tool is asynchronous a",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "input": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40000,
              "description": "The finance research question requiring in-depth investigation of financial data, SEC filings, earnings, and company metrics."
            },
            "task_id": {
              "description": "Task ID returned by a previous call. When provided, polls that background finance research task for its status/result instead of starting a new one.",
              "type": "string"
            },
            "research_effort": {
              "default": "deep",
              "description": "Controls how much time and effort the Finance Research API spends on your question. deep: thorough (default), exhaustive: most comprehensive.",
              "type": "string",
              "enum": [
                "deep",
                "exhaustive"
              ]
            },
            "output_schema": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {},
              "description": "Beta. Requests structured JSON output in `output.content` using a supported JSON Schema subset. Supported with every `research_effort` value. The rules and limits match the Research API, so the same schema works on both endpoints. Limits are enforced before model execution; the request fails with `422` if any limit is exceeded (max nesting depth 5, max total properties 100, max total enum values 500, max total schema string budget 25,000). The schema root must be a JSON object."
            }
          }
        },
        "annotations": {
          "readOnlyHint": true,
          "destructiveHint": false,
          "openWorldHint": true
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "output": {
              "description": "The research output containing the answer and sources",
              "type": "object",
              "properties": {
                "content": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  ],
                  "description": "Comprehensive finance-grade response with inline citations. By default a Markdown string with numbered citations; when `output_schema` was provided, a JSON object conforming to the requested schema."
                },
                "content_type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "object"
                  ],
                  "description": "The format of the content field"
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "url": {
                        "type": "string",
                        "description": "Source webpage URL"
                      },
                      "title": {
                        "description": "Source webpage title",
                        "type": "string"
                      },
                      "snippets": {
                        "description": "Relevant excerpts from the source page used in generating the answer",
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  "description": "List of sources used to generate the answer"
                }
              },
              "required": [
                "content",
                "content_type",
                "sources"
              ],
              "additionalProperties": false
            },
            "warnings": {
              "description": "Non-fatal warnings generated during the request, such as a deprecation notice for an `output_schema` that will stop being accepted in a future release. Empty when no warnings occurred.",
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "task_id": {
              "description": "Unique identifier for the background finance research task",
              "type": "string"
            },
            "type": {
              "description": "The task type",
              "type": "string",
              "const": "finance_research"
            },
            "status": {
              "description": "The current status of the background finance research task",
              "type": "string",
              "enum": [
                "queued",
                "running",
                "completed",
                "failed",
                "cancelled"
              ]
            },
            "created_at": {
              "description": "When the task was created, in RFC 3339 format",
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    ],
    "error": null
  },
